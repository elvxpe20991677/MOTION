# Environnements et dépendances (reproductibles depuis requirements.txt / package-lock.json)
.venv/
.venv-blender/
node_modules/
__pycache__/
*.pyc

# Rendus : lourds et régénérables
build/
out/**/*.mov
out/**/*.mp4
out/**/*.png
assets/audio/*.wav

# Dépôt d’un outil tiers, étranger au projet
archive-*/

# Médias générés par les tests (vidéo, sous-titres, audio)
assets/_tests/
# Rendus des modèles (templates/) : sorties de vérification, régénérables
out/modele_*/
out/*_draft/
assets/audio/modele_*_beat.wav.synth.json
assets/audio/*_draft_beat.wav.synth.json
out/essai_*/
assets/audio/essai_*_beat.wav.synth.json

# Secrets (clé API ElevenLabs…) : jamais versionnés. Modèle sans valeurs : .env.example
.env
.env.*
!.env.example

# Médias des assets IA gelés : NON versionnés par défaut (dépôt public, licences des services, poids).
# Leur empreinte SHA-256 et leur provenance le sont, dans assets.lock.json (CONTRACT §11.4).
assets/ai/*
!assets/ai/README.md

# Provenance C2PA : certificat et clé privée locaux (phase 7) ; outils téléchargés (c2patool)
.c2pa/
.tools/
# Fiche d'encodage et rapports C2PA : état local (chemins, empreintes de la machine), non versionnés
out/**/encode_record.json
out/**/c2pa_report.json
out/**/c2pa_report.md
.venv-blender52/
