{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://mograph.render/schema/internal/blender_job.schema.json",
  "title": "Tâche Blender (contrat mograph-blender-job/1)",
  "description": "Produite par pipeline/scene.py (entièrement résolue), écrite dans <plate_dir>/job.json par pipeline/blender_render.py, lue par backends/blender_backend.py (Python 3.11 + bpy 5.0.1). Aucune référence de temps, d'alias d'easing ou de nom de palette ne subsiste : images flottantes, interpolations Blender, couleurs hexadécimales sRGB.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "scene_id", "shot_id", "plate_id", "out_dir", "frames", "fps", "width", "height", "transparent", "seed", "render", "world", "camera", "lights", "objects"],
  "properties": {
    "contract": { "const": "mograph-blender-job/1" },
    "scene_id": { "type": "string" },
    "shot_id": { "type": "string" },
    "plate_id": { "type": "string" },
    "out_dir": { "type": "string", "description": "Chemin ABSOLU du dossier de sortie ; image i -> out_dir/%06d.png (i de 0 à frames-1)." },
    "frames": { "type": "integer", "minimum": 1, "description": "Images 0..frames-1 = images locales du plan (scene.frame_start = 0)." },
    "fps": { "enum": [24, 25, 30, 50, 60] },
    "width": { "type": "integer", "minimum": 16, "description": "Pixels réels = largeur d'affichage x device_scale_factor x plate_scale, arrondi au pair." },
    "height": { "type": "integer", "minimum": 16 },
    "transparent": { "type": "boolean", "description": "film_transparent : PNG RGBA à alpha droit." },
    "seed": { "type": "integer", "minimum": 0, "maximum": 2147483647, "description": "Graine Cycles fixe (use_animated_seed = true fait varier le bruit par image de façon reproductible)." },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device", "samples", "adaptive_threshold", "denoise", "view_transform", "look", "exposure", "bounces", "caustics", "motion_blur_shutter"],
      "properties": {
        "device": { "enum": ["auto", "CPU", "OPTIX", "CUDA"], "description": "auto = OPTIX si un GPU NVIDIA est détecté, sinon CPU." },
        "samples": { "type": "integer", "minimum": 1 },
        "adaptive_threshold": { "type": "number", "exclusiveMinimum": 0 },
        "denoise": { "type": "boolean", "description": "OIDN (OpenImageDenoise)." },
        "view_transform": { "type": "string", "description": "Ex. 'AgX'." },
        "look": { "type": "string", "description": "Nom court ('Base Contrast', 'Medium High Contrast', 'None'). Le backend essaie le nom court puis '<view_transform> - <nom>' ; échec explicite si aucun n'est accepté." },
        "exposure": { "type": "number" },
        "bounces": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "diffuse", "glossy", "transmission", "transparent", "volume"],
          "properties": {
            "total": { "type": "integer", "minimum": 0 },
            "diffuse": { "type": "integer", "minimum": 0 },
            "glossy": { "type": "integer", "minimum": 0 },
            "transmission": { "type": "integer", "minimum": 0 },
            "transparent": { "type": "integer", "minimum": 0 },
            "volume": { "type": "integer", "minimum": 0 }
          }
        },
        "caustics": { "type": "boolean" },
        "motion_blur_shutter": { "type": "number", "minimum": 0, "description": "0 = flou de mouvement Cycles désactivé ; sinon render.motion_blur_shutter (fraction d'image), position centrée." }
      }
    },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "required": ["color", "strength", "sky"],
      "properties": {
        "color": { "$ref": "#/$defs/hex" },
        "strength": { "type": "number", "minimum": 0 },
        "sky": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["sun_elevation", "sun_rotation", "altitude", "air", "dust", "ozone", "sun_size", "sun_intensity"],
              "properties": {
                "sun_elevation": { "type": "number", "description": "Degrés." },
                "sun_rotation": { "type": "number", "description": "Degrés." },
                "altitude": { "type": "number" },
                "air": { "type": "number" },
                "dust": { "type": "number" },
                "ozone": { "type": "number" },
                "sun_size": { "type": "number", "description": "Degrés." },
                "sun_intensity": { "type": "number" }
              }
            }
          ],
          "description": "null = fond uni 'color' ; objet = ciel physique (Sky Texture, modèle choisi par introspection de l'enum sky_type)."
        }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["location", "target", "lens", "fstop", "sensor_width", "channels"],
      "properties": {
        "location": { "$ref": "#/$defs/vec3" },
        "target": { "$ref": "#/$defs/vec3", "description": "Position de l'objet vide visé (contrainte TRACK_TO) et point de mise au point." },
        "lens": { "type": "number", "exclusiveMinimum": 0 },
        "fstop": { "anyOf": [ { "type": "number", "exclusiveMinimum": 0 }, { "type": "null" } ], "description": "null = pas de profondeur de champ." },
        "sensor_width": { "type": "number", "exclusiveMinimum": 0 },
        "channels": { "type": "array", "items": { "$ref": "#/$defs/channel" }, "description": "prop 'location' (caméra) ou 'target' (objet vide visé)." }
      }
    },
    "lights": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "shape", "size", "size_y", "energy", "color", "location", "target", "spot_size", "angle", "channels"],
        "properties": {
          "id": { "type": "string" },
          "type": { "enum": ["AREA", "SUN", "POINT", "SPOT"] },
          "shape": { "enum": ["DISK", "SQUARE", "RECTANGLE", "ELLIPSE"] },
          "size": { "type": "number", "minimum": 0, "description": "AREA : taille (m) ; POINT/SPOT : rayon (shadow_soft_size)." },
          "size_y": { "type": "number", "minimum": 0 },
          "energy": { "type": "number", "minimum": 0 },
          "color": { "$ref": "#/$defs/hex" },
          "location": { "$ref": "#/$defs/vec3" },
          "target": { "$ref": "#/$defs/vec3", "description": "Orientation : contrainte TRACK_TO vers un objet vide à cette position." },
          "spot_size": { "type": "number", "description": "Degrés." },
          "angle": { "type": "number", "description": "SUN : degrés." },
          "channels": { "type": "array", "items": { "$ref": "#/$defs/channel" } }
        }
      }
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "primitive", "size", "minor", "bevel", "location", "rotation", "scale", "material", "channels"],
        "properties": {
          "id": { "type": "string" },
          "primitive": { "enum": ["sphere", "cube", "rounded_cube", "torus", "cylinder", "cone", "plane", "cyclorama"] },
          "size": { "type": "number", "exclusiveMinimum": 0, "description": "Diamètre (sphère, cylindre, cône, tore : diamètre extérieur), arête (cube, rounded_cube, plane), largeur = profondeur du sol (cyclorama)." },
          "minor": { "type": "number", "exclusiveMinimum": 0, "description": "Tore : rayon du tube ; cyclorama : hauteur du mur de fond." },
          "bevel": { "type": "number", "minimum": 0, "description": "rounded_cube : largeur de biseau (6 segments) ; cyclorama : rayon du congé sol/mur." },
          "location": { "$ref": "#/$defs/vec3" },
          "rotation": { "$ref": "#/$defs/vec3", "description": "DEGRÉS, ordre XYZ (le backend convertit en radians)." },
          "scale": { "$ref": "#/$defs/vec3" },
          "material": { "$ref": "#/$defs/material" },
          "channels": { "type": "array", "items": { "$ref": "#/$defs/channel" } }
        }
      }
    }
  },
  "$defs": {
    "hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "description": "sRGB ; le backend convertit en linéaire pour Blender." },
    "vec3": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "base_color", "roughness", "metallic", "specular", "sheen", "sheen_roughness", "coat", "coat_roughness", "subsurface", "transmission", "ior", "anisotropic", "emission", "emission_strength"],
      "properties": {
        "name": { "type": "string" },
        "base_color": { "$ref": "#/$defs/hex" },
        "roughness": { "type": "number" },
        "metallic": { "type": "number" },
        "specular": { "type": "number", "description": "Specular IOR Level (0,5 = neutre)." },
        "sheen": { "type": "number", "description": "Sheen Weight." },
        "sheen_roughness": { "type": "number" },
        "coat": { "type": "number", "description": "Coat Weight." },
        "coat_roughness": { "type": "number" },
        "subsurface": { "type": "number", "description": "Subsurface Weight." },
        "transmission": { "type": "number", "description": "Transmission Weight." },
        "ior": { "type": "number" },
        "anisotropic": { "type": "number" },
        "emission": { "$ref": "#/$defs/hex" },
        "emission_strength": { "type": "number" }
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interpolation", "easing"],
      "properties": {
        "interpolation": { "enum": ["CONSTANT", "LINEAR", "BEZIER", "SINE", "QUAD", "CUBIC", "QUART", "QUINT", "EXPO", "CIRC", "BACK", "BOUNCE", "ELASTIC"] },
        "easing": { "enum": ["AUTO", "EASE_IN", "EASE_OUT", "EASE_IN_OUT"] },
        "back": { "type": "number", "description": "BACK : keyframe.back." },
        "amplitude": { "type": "number", "description": "ELASTIC : keyframe.amplitude (toujours 0)." },
        "period": { "type": "number", "description": "ELASTIC : keyframe.period EN IMAGES (= période GSAP x durée du segment en images)." }
      }
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prop", "keys"],
      "properties": {
        "prop": { "enum": ["location", "rotation", "scale", "target"], "description": "rotation en DEGRÉS ; target = objet vide visé (caméra, lumières)." },
        "keys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["frame", "value", "out"],
            "properties": {
              "frame": { "type": "number", "description": "Numéro d'image FLOTTANT (temps local x fps)." },
              "value": { "$ref": "#/$defs/vec3" },
              "out": {
                "anyOf": [ { "$ref": "#/$defs/segment" }, { "type": "null" } ],
                "description": "Interpolation du segment qui PART de cette clé (Blender la lit sur la clé de départ). Le compilateur l'a déduite de l'ease de la clé SUIVANTE (ease = segment qui arrive). null sur la dernière clé."
              }
            }
          }
        }
      }
    }
  }
}
