{
  "$schema": "../schema/scene.schema.json",
  "version": "1.0",
  "id": "demo_vhs_kinetic",
  "title": "Tout se rejoue — typo cinétique VHS",
  "brief": "Format vertical pour les réseaux : une phrase martelée mot à mot sur une boucle à 120 BPM, chaque mot frappe exactement sur le temps, avec un accroc de bande VHS à chaque impact.",
  "seed": 120,
  "preset": "vhs_glitch",
  "format": {
    "aspect": "9:16",
    "resolution": "1080p",
    "fps": 30,
    "alpha": false
  },
  "audio": {
    "src": "assets/audio/beat_120.wav",
    "bpm": 120,
    "offset": 0,
    "beats_per_bar": 4,
    "synth": {
      "kind": "beat"
    }
  },
  "storyboard": [
    {
      "shot": "phrase",
      "intent": "Faire sentir le tempo : l'œil reçoit un mot par temps, l'impact visuel coïncide avec la grosse caisse.",
      "notes": "Mots centrés sur la zone sûre titre (et non sur le cadre) pour rester lisibles sous l'interface des réseaux ; glitch bref sur chaque temps."
    }
  ],
  "outputs": [
    {
      "profile": "hevc_main10",
      "crf": 18
    },
    {
      "profile": "prores_422hq"
    }
  ],
  "qc": {
    "safe_zone": "title",
    "safe_zone_tolerance_s": 0.5,
    "allow_black_s": 0,
    "determinism_frames": 8,
    "loudness_target_lufs": -14
  },
  "shots": [
    {
      "id": "phrase",
      "duration": "beats:10",
      "background": "bg",
      "fx": {
        "glitch": {
          "on_beats": {
