    "plate_scale": 1
  },
  "storyboard": [
    {
      "shot": "title",
      "intent": "Poser le sujet : un titre fort qui se construit, des formes pop qui donnent le ton graphique.",
      "notes": "Formes en arrière-plan à droite, bloc texte à gauche dans la zone sûre ; soulignement tracé pour guider l'œil vers le sous-titre."
    },
    {
      "shot": "chart",
      "intent": "Montrer la progression : chaque barre pousse l'une après l'autre, son compteur suit exactement la barre.",
      "notes": "Fondu enchaîné 0,4 s depuis le titre ; easing sans dépassement pour ne jamais afficher une valeur fausse."
    }
  ],
  "outputs": [
    {
