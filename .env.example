# Modèle des variables d'environnement locales de mograph.
# Copier ce fichier en .env (ignoré par git) puis renseigner les valeurs.
# Ne JAMAIS committer .env ni coller une clé dans un fichier suivi, un journal ou un rapport.

# Clé API ElevenLabs (tableau de bord ElevenLabs > Developers > API Keys).
ELEVENLABS_API_KEY=

# Identifiant de la voix ElevenLabs utilisée par défaut pour la synthèse vocale.
ELEVENLABS_VOICE_ID=
